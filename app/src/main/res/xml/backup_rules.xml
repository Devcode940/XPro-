<?xml version="1.0" encoding="utf-8"?>
<!--
  Production backup policy: back up shared preferences (app settings only), but never the
  Room database — it contains private bookmarks, drafts, DMs and feedback.
-->
<full-backup-content>
    <exclude domain="database" path="xpro_unlocked.db" />
    <exclude domain="database" path="xpro_unlocked.db-wal" />
    <exclude domain="database" path="xpro_unlocked.db-shm" />
    <exclude domain="file" path="." />
</full-backup-content>
