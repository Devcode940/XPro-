<?xml version="1.0" encoding="utf-8"?>
<!--
  Production data-extraction policy (Android 12+): the Room database and app-private files
  are never extracted to cloud backup or device transfer. Shared preferences are allowed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="xpro_unlocked.db" />
        <exclude domain="database" path="xpro_unlocked.db-wal" />
        <exclude domain="database" path="xpro_unlocked.db-shm" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="xpro_unlocked.db" />
        <exclude domain="database" path="xpro_unlocked.db-wal" />
        <exclude domain="database" path="xpro_unlocked.db-shm" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
