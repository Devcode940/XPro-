{
  "name": "xpro-firestore-rules-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore security rules for XPro (users/{uid}/bookmarks, bookmark_folders) and their emulator-backed test suite.",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-xpro \"node --test firestore.test.js\"",
    "test:rules:emulated": "node --test firestore.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^15.37.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
